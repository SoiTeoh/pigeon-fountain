{
  "name": "pigeon-fountain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "node -e \"import('vite').then(async ({createServer})=>{const s=await createServer({server:{middlewareMode:true},appType:'custom',logLevel:'silent'});try{await s.ssrLoadModule('/tools/balance.ts')}finally{await s.close()}})\""
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
